{
  "openapi": "3.0.3",
  "info": {
    "title": "Modern Library API",
    "version": "1.2.0",
    "description": "API docs for Modern Library mega-platform modules (learning, kids, realtime, commerce, compliance, security)."
  },
  "servers": [{ "url": "http://localhost:5000" }],
  "tags": [
    { "name": "System" },
    { "name": "Auth" },
    { "name": "Users" },
    { "name": "AI" },
    { "name": "Books" },
    { "name": "Courses" },
    { "name": "Products" },
    { "name": "Rides" },
    { "name": "Transport" },
    { "name": "Hostels" },
    { "name": "Kids" },
    { "name": "Assessment" },
    { "name": "Compliance" },
    { "name": "Business" },
    { "name": "Queues" },
    { "name": "Live Classroom" },
    { "name": "Partners" },
    { "name": "Marketplace" },
    { "name": "Past Papers" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "VALIDATION_ERROR" },
              "message": { "type": "string", "example": "Request validation failed" },
              "details": { "type": "object" }
            }
          },
          "requestId": { "type": "string", "example": "4a35060e-dc7a-4a27-a9df-1db6a419f7db" }
        }
      },
      "SuccessEnvelope": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation or malformed request error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication required or token invalid",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated but not allowed",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  },
  "paths": {
    "/api/system/health": {
      "get": { "tags": ["System"], "summary": "Liveness probe", "responses": { "200": { "description": "Alive" } } }
    },
    "/api/system/ready": {
      "get": { "tags": ["System"], "summary": "Readiness probe", "responses": { "200": { "description": "Ready" }, "503": { "description": "Not ready" } } }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" },
                  "role": { "type": "string", "example": "student" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Registered" } }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login user",
        "responses": {
          "200": { "description": "Access + refresh token" },
          "202": { "description": "MFA required" }
        }
      }
    },
    "/api/auth/mfa/challenge": {
      "post": { "tags": ["Auth"], "summary": "Create MFA challenge (scaffold)", "responses": { "202": { "description": "Challenge created" } } }
    },
    "/api/auth/mfa/verify": {
      "post": { "tags": ["Auth"], "summary": "Verify MFA challenge", "responses": { "200": { "description": "MFA verified" } } }
    },
    "/api/auth/refresh": {
      "post": { "tags": ["Auth"], "summary": "Rotate refresh token", "responses": { "200": { "description": "Token rotated" }, "401": { "description": "Invalid token" } } }
    },
    "/api/auth/sessions": {
      "get": { "tags": ["Auth"], "summary": "List active sessions", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Sessions" } } }
    },
    "/api/auth/sessions/revoke": {
      "post": { "tags": ["Auth"], "summary": "Revoke a session", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Revoked" } } }
    },
    "/api/auth/sessions/revoke-all": {
      "post": { "tags": ["Auth"], "summary": "Revoke all sessions", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Revoked all" } } }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout current session",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              },
              "example": {
                "refreshToken": "c0f3...6a9"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Logged out" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/users/register": {
      "post": {
        "tags": ["Users"],
        "summary": "Legacy register endpoint",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 }
                }
              },
              "example": {
                "name": "Legacy User",
                "email": "legacy@example.com",
                "password": "StrongPassword123!"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Registered" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/users/login": {
      "post": {
        "tags": ["Users"],
        "summary": "Legacy login endpoint",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              },
              "example": {
                "email": "legacy@example.com",
                "password": "StrongPassword123!"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Logged in" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/ai/chat": {
      "post": {
        "tags": ["AI"],
        "summary": "AI tutor chat",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": { "type": "string", "minLength": 1 },
                  "context": { "type": "object" }
                }
              },
              "example": {
                "message": "Teach me binary search.",
                "context": { "level": "beginner" }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "AI response returned" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },

    "/api/kids/profiles": {
      "post": { "tags": ["Kids"], "summary": "Create kid profile", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Created" } } },
      "get": { "tags": ["Kids"], "summary": "List parent kid profiles", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Profiles" } } }
    },
    "/api/kids/content": {
      "get": { "tags": ["Kids"], "summary": "List kid-safe content for kidId", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Content list" }, "403": { "description": "Forbidden" } } }
    },
    "/api/kids/progress": {
      "post": { "tags": ["Kids"], "summary": "Upsert kid progress", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Progress recorded" } } }
    },
    "/api/kids/rewards/{kidId}": {
      "get": {
        "tags": ["Kids"],
        "summary": "Get kid rewards",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "kidId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Rewards" } }
      }
    },
    "/api/kids/parent-controls/{kidId}": {
      "put": {
        "tags": ["Kids"],
        "summary": "Update parent controls",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "kidId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Updated" } }
      }
    },
    "/api/kids/safety-events": {
      "get": { "tags": ["Kids"], "summary": "List kid safety events", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Events" } } }
    },

    "/api/assessment/assignments": {
      "post": { "tags": ["Assessment"], "summary": "Create assignment", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Created" } } }
    },
    "/api/assessment/submissions": {
      "post": { "tags": ["Assessment"], "summary": "Submit assignment", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Submitted" } } }
    },
    "/api/assessment/submissions/{id}/ai-grade": {
      "post": { "tags": ["Assessment"], "summary": "Draft AI grade", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Drafted" } } }
    },
    "/api/assessment/submissions/{id}/finalize": {
      "patch": { "tags": ["Assessment"], "summary": "Finalize grade", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Finalized" }, "403": { "description": "Teacher/admin only" } } }
    },
    "/api/assessment/submissions/{id}": {
      "get": { "tags": ["Assessment"], "summary": "Get submission details", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Submission details" } } }
    },

    "/api/compliance/consent": {
      "post": { "tags": ["Compliance"], "summary": "Record consent version", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Recorded" } } }
    },
    "/api/compliance/dsar/export": {
      "post": { "tags": ["Compliance"], "summary": "Request DSAR export", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Requested" } } }
    },
    "/api/compliance/dsar/delete": {
      "post": { "tags": ["Compliance"], "summary": "Request DSAR deletion", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Requested" } } }
    },
    "/api/compliance/dsar": {
      "get": {
        "tags": ["Compliance"],
        "summary": "List DSAR requests (admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["requested", "in_progress", "completed", "rejected"] } },
          { "name": "requestType", "in": "query", "schema": { "type": "string", "enum": ["export", "delete"] } },
          { "name": "userId", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }
        ],
        "responses": { "200": { "description": "Paginated DSAR requests list" } }
      }
    },
    "/api/compliance/dsar/{id}": {
      "get": { "tags": ["Compliance"], "summary": "Get DSAR request", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "DSAR" } } }
    },
    "/api/compliance/dsar/{id}/status": {
      "patch": { "tags": ["Compliance"], "summary": "Update DSAR status (admin)", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Updated" } } }
    },
    "/api/compliance/retention/sweep": {
      "post": { "tags": ["Compliance"], "summary": "Trigger retention sweep", "security": [{ "bearerAuth": [] }], "responses": { "202": { "description": "Queued" } } }
    },

    "/api/business/plans": {
      "post": { "tags": ["Business"], "summary": "Create subscription plan", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Created" } } }
    },
    "/api/business/subscriptions": {
      "post": { "tags": ["Business"], "summary": "Subscribe current user", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Subscribed" } } }
    },
    "/api/business/subscriptions/my": {
      "get": { "tags": ["Business"], "summary": "List my subscriptions", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Subscription list" } } }
    },
    "/api/business/marketplace/disputes/{listingId}/open": {
      "post": { "tags": ["Business"], "summary": "Open marketplace dispute", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Dispute opened" } } }
    },
    "/api/business/marketplace/disputes/{id}/respond": {
      "post": { "tags": ["Business"], "summary": "Respond to dispute", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Responded" } } }
    },
    "/api/business/marketplace/disputes/{id}/resolve": {
      "post": { "tags": ["Business"], "summary": "Resolve dispute (admin)", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Resolved" } } }
    },
    "/api/business/finance/summary": {
      "get": { "tags": ["Business"], "summary": "Finance summary (entitled)", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Summary" }, "402": { "description": "Entitlement required" } } }
    },
    "/api/books": {
      "post": {
        "tags": ["Books"],
        "summary": "Create a book (admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "author"],
                "properties": {
                  "title": { "type": "string" },
                  "author": { "type": "string" },
                  "genre": { "type": "string" },
                  "copies": { "type": "integer", "minimum": 0 }
                }
              },
              "example": {
                "title": "Introduction to Operating Systems",
                "author": "Silberschatz",
                "copies": 4
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/books/{id}/borrow": {
      "post": {
        "tags": ["Books"],
        "summary": "Borrow book",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Borrowed" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/books/{id}/return": {
      "post": {
        "tags": ["Books"],
        "summary": "Return book",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Returned" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/courses": {
      "post": {
        "tags": ["Courses"],
        "summary": "Create course (admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "price"],
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "instructor": { "type": "string" },
                  "price": {
                    "type": "object",
                    "required": ["amount"],
                    "properties": {
                      "amount": { "type": "number", "minimum": 0 },
                      "currency": { "type": "string", "enum": ["KES", "USD", "EUR", "GBP"] }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/courses/{id}/enroll": {
      "post": {
        "tags": ["Courses"],
        "summary": "Enroll to course",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Enrolled" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/products": {
      "post": {
        "tags": ["Products"],
        "summary": "Create product (admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "price"],
                "properties": {
                  "name": { "type": "string" },
                  "price": {
                    "type": "object",
                    "required": ["amount"],
                    "properties": {
                      "amount": { "type": "number", "minimum": 0 },
                      "currency": { "type": "string", "enum": ["KES", "USD", "EUR", "GBP"] }
                    }
                  },
                  "seller": { "type": "string" },
                  "stock": { "type": "integer", "minimum": 0 },
                  "category": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/products/{id}/buy": {
      "post": {
        "tags": ["Products"],
        "summary": "Buy product",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Purchased" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/rides": {
      "post": {
        "tags": ["Rides"],
        "summary": "Create ride (admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["from", "to", "price"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" },
                  "driver": { "type": "string" },
                  "seats": { "type": "integer", "minimum": 0 },
                  "price": {
                    "type": "object",
                    "required": ["amount"],
                    "properties": {
                      "amount": { "type": "number", "minimum": 0 },
                      "currency": { "type": "string", "enum": ["KES", "USD", "EUR", "GBP"] }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/transport/{id}/book": {
      "post": {
        "tags": ["Transport"],
        "summary": "Book transport ride",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Booked" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/hostels/{id}/book": {
      "post": {
        "tags": ["Hostels"],
        "summary": "Book hostel room",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Booked" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },

    "/api/queues/{name}/metrics": {
      "get": {
        "tags": ["Queues"],
        "summary": "Queue metrics",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Metrics" } }
      }
    },
    "/api/queues/{name}/dead-letter/replay": {
      "post": {
        "tags": ["Queues"],
        "summary": "Replay dead-letter job",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string", "enum": ["settlement-generation", "file-post-processing", "notifications", "retention-sweep"] } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["deadLetterJobId"],
                "properties": {
                  "deadLetterJobId": { "type": "string" }
                }
              },
              "example": {
                "deadLetterJobId": "172"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Replayed" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },

    "/api/live-classrooms/realtime/config": {
      "get": { "tags": ["Live Classroom"], "summary": "Socket/WebRTC config", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Config" } } }
    },
    "/api/live-classrooms": {
      "post": {
        "tags": ["Live Classroom"],
        "summary": "Create classroom",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "subject": { "type": "string" },
                  "teacherIds": { "type": "array", "items": { "type": "string" } },
                  "learnerIds": { "type": "array", "items": { "type": "string" } },
                  "visibility": { "type": "string", "enum": ["public", "private"] }
                }
              },
              "example": {
                "title": "Discrete Mathematics Class A",
                "subject": "Math",
                "visibility": "private"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/live-classrooms/{classroomId}/sessions": {
      "post": {
        "tags": ["Live Classroom"],
        "summary": "Create classroom session",
